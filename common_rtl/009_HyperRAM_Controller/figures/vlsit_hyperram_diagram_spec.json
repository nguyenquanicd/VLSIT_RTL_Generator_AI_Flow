    },
    {
      "id": "INTR",
      "name": "Enabled interrupt status",
      "category": "custom interrupt",
      "active": "controller \u2192 SoC interrupt controller",
      "signals": "o_int_hyperram"
    },
    {
      "id": "CRCO",
      "name": "Core clock (2 x CK) and core reset",
      "category": "clock/reset",
      "active": "SoC clock/reset controller \u2192 core modules",
      "signals": "i_clk_core, i_rst_n_core"
    },
    {
      "id": "CRAP",
      "name": "Independent APB4 clock and reset",
      "category": "clock/reset",
      "active": "SoC clock/reset controller \u2192 APB modules",
      "signals": "i_clk_apb, i_rst_n_apb"
    },
    {
      "id": "APBX",
      "name": "APB4 transfer request and response",
      "category": "internal interface",
      "active": "APB interface \u2192 CDC bridge",
      "signals": "address, write direction, write data, byte strobes, protection attributes, response data, ready, transfer error"
    },
    {
      "id": "CSR",
      "name": "Cross-domain CSR request and response",
      "category": "internal interface",
      "active": "CDC bridge \u2194 CSR register file",
      "signals": "request address, request direction, request write data, request byte strobes, request valid, request ready, response read data, response error, response valid, response ready"
    },
    {
      "id": "CFG",
      "name": "Controller configuration and status",
      "category": "internal interface",
      "active": "CSR register file \u2194 HyperBus controller",
      "signals": "enable, per-chip-select timing counts and presets, CK divider, status, interrupt events, device command"
    },
    {
      "id": "AXI",
      "name": "Memory transaction request and response",
      "category": "internal interface",
      "active": "AXI frontend \u2194 HyperBus controller",
      "signals": "address, transaction ID, burst length, transfer size, burst type, write data, byte strobes, read data, response status, request and response handshakes"
    },
    {
      "id": "PHY",
      "name": "HyperBus command, data and timing controls",
      "category": "internal interface",
      "active": "HyperBus controller \u2192 PHY",
      "signals": "command/address, read/write direction, data, byte mask, chip select, reset, pin output enables, captured data, RWDS status"
    },
    {
      "id": "CRAX",
      "name": "AXI4 clock and reset",
      "category": "clock/reset",
      "active": "SoC clock/reset controller \u2192 AXI crossing",
      "signals": "i_clk_axi, i_rst_n_axi"
    },
    {
      "id": "AXIC",
      "name": "AXI4 channels after the clock crossing",
      "category": "internal interface",
      "active": "AXI crossing \u2192 AXI frontend",
      "signals": "AW, W, B, AR and R channels in the core clock domain"
    },
    {
      "id": "HBDLY",
      "name": "Read-capture delay line",
      "category": "custom SoC-owned cell",
      "active": "PHY \u2194 SoC delay line",
      "signals": "o_hb_rwds_dly_sel[PARA_DLY_TAP_W-1:0], i_clk_cap"
    }
  ],
  "legend_note": "The top module is structural. HyperBus control and the PHY run on CLK-CORE (2 x CK); the AXI4 interface runs on CLK-AXI, the same clock as CLK-CORE or an asynchronous one behind the AXI crossing; APB4 is asynchronous on CLK-APB. DQ and RWDS cross the top boundary as separate input, output and active-high OE signals; the SoC pad wrapper maps them to the pads and provides the delay line of the read capture."
}