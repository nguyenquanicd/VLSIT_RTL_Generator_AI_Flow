        <mxCell id="i47__2" value="The top module is structural. AXI4 and HyperBus share CLK-CORE; APB4 is asynchronous on CLK-APB. DQ/RWDS cross the top boundary as separate input, output, and active-high OE signals; the SoC pad wrapper creates the physical bidirectional buses. APB-only reset requires an idle APB bus and no CDC request or response pending and preserves core and memory state." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=18;fontColor=#000000;spacing=2;" vertex="1" parent="1" vlsit_library_sha256="D1631ACF98A920526B235E8970FEDDC9305EA2F0D6A35C6529CD220D62AFABB6" vlsit_library_entry="0" vlsit_library_cell="2" vlsit_library_instance="i47">
