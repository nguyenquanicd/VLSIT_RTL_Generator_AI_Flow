            <mxRectangle width="330" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i24__r1__c1" value="Structural top of the FIFO that moves words between two synchronous clocks of different frequency. It joins the write side, the read side and the storage and holds no logic of its own. The two pointers cross between the sides as timed paths with no synchronizer." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__r1" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="58" as="geometry">
            <mxRectangle width="1480" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i24__r1__c2" value="Section 14.2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__r1" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="58" as="geometry">
            <mxRectangle width="230" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i24__r1__c3" value="WRI, RDI, SRST, CRWR, CRRD" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__r1" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="58" as="geometry">
            <mxRectangle width="360" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i24__r2" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__t" vlsit_native_table="1">
          <mxGeometry y="134" width="2400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i24__r2__c0" value="u_wr (m_vlsit_sfifo_wr)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__r2" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="80" as="geometry">
            <mxRectangle width="330" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i24__r2__c1" value="Write side in the write clock domain. It owns the write pointer, accepts a write when the FIFO is not full and no software reset blocks it, and keeps the full and full-threshold flags exact by computing them from the next pointers. It raises a one-cycle overflow pulse for a rejected write, drives the memory write port, and runs the write half of the four-phase software reset sequence." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__r2" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i24__r2__c2" value="Section 14.2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__r2" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="80" as="geometry">
            <mxRectangle width="230" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i24__r2__c3" value="PTR, MWP, WRI, SRST, CRWR" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__r2" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="80" as="geometry">
            <mxRectangle width="360" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i24__r3" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__t" vlsit_native_table="1">
          <mxGeometry y="214" width="2400" height="102" as="geometry" />
        </mxCell>
        <mxCell id="i24__r3__c0" value="u_rd (m_vlsit_sfifo_rd)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__r3" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="102" as="geometry">
            <mxRectangle width="330" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i24__r3__c1" value="Read side in the read clock domain. It owns the read pointer, accepts a read when the FIFO is not empty and no software reset blocks it, and keeps the empty and empty-threshold flags exact by computing them from the next pointers. It addresses the storage with the next read pointer so that the output already shows the following word (show-ahead), raises a one-cycle underflow pulse for a rejected read, and runs the read half of the software reset sequence." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__r3" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="102" as="geometry">
            <mxRectangle width="1480" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i24__r3__c2" value="Section 14.2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__r3" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="102" as="geometry">
            <mxRectangle width="230" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i24__r3__c3" value="PTR, MRP, RDI, CRRD" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__r3" vlsit_native_table="1">
