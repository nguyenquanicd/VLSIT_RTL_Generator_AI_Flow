        </mxCell>
        <mxCell id="i24__r4__c0" value="u_mem (m_vlsit_sfifo_mem)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__r4" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="58" as="geometry">
            <mxRectangle width="330" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i24__r4__c1" value="Storage of the FIFO: one write port in the write clock domain and one read port in the read clock domain with a registered output. It is a flop array by default or a library SRAM behind a wrapper. The content is not reset; it is consumed only after the write pointer proved that the entry was written." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__r4" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="58" as="geometry">
            <mxRectangle width="1480" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i24__r4__c2" value="Section 14.2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i24__r4" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="58" as="geometry">
            <mxRectangle width="230" height="58" as="alternateBounds" />
