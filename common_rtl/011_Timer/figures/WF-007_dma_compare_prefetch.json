{
  "head": {
    "text": "WF-007 DMA compare/update req/ack prefetch, boundary commit, early-ack error, and CSR clear"
  },
  "signal": [
    {
      "name": "i_clk_timer",
      "wave": "p........................."
    },
    [
      "Compare/update req/ack",
      {
        "name": "o_dma_cmp_req",
        "wave": "01111110000011110000000111"
      },
      {
        "name": "APB_compare_stream_write",
        "wave": "x..==x........=x..........",
