        <mxCell id="i78__2" value="Four channel, filter, and capture FIFO instances are represented by instance banks; each channel has its own mode, filter state, timestamp FIFO, and status. The shared counter update event reaches the IRQ aggregator through the channel/status bank. DMA data moves through memory-mapped timer data ports; the two req/ack pairs carry DMA request control, not payload data. APB/core CDC and DMA data-port placement remain open design details." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=18;fontColor=#000000;spacing=2;" vertex="1" parent="1" vlsit_library_sha256="D1631ACF98A920526B235E8970FEDDC9305EA2F0D6A35C6529CD220D62AFABB6" vlsit_library_entry="0" vlsit_library_cell="2" vlsit_library_instance="i78">
