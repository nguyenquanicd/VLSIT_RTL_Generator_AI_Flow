{
  "head": {
    "text": "WF-006 DMA capture req/ack burst, early-ack error, and CSR clear recovery"
  },
  "signal": [
    {
      "name": "i_clk_timer",
      "wave": "p........................."
    },
    [
      "Capture req/ack",
      {
        "name": "o_dma_cap_req",
        "wave": "01111110000011100000000000"
      },
      {
        "name": "APB_capture_stream_read",
        "wave": "x..==x....................",
        "data": [
          "META_CH0",
          "TS_0x17"
        ]
      },
      {
        "name": "i_dma_cap_ack",
        "wave": "00000011100000110000000000"
      },
      {
