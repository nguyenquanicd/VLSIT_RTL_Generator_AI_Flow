        <mxCell id="i42__r2" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i42__t" vlsit_native_table="1">
          <mxGeometry y="134" width="2400" height="102" as="geometry" />
        </mxCell>
        <mxCell id="i42__r2__c0" value="u_aw (m_vlsit_axi_async_aw)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i42__r2" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="102" as="geometry">
            <mxRectangle width="330" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i42__r2__c1" value="AW channel. It packs every field of the AXI write address channel into one word, writes it into an asynchronous Gray-code FIFO in the clock domain of the source side, and unpacks the word on the other side of the clock boundary. The handshake maps directly: the source ready is the inverse of the FIFO full flag and the destination valid is the inverse of the FIFO empty flag. The order of the words is kept and no field is changed or checked. Optional fields that are not present are not stored." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i42__r2" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="102" as="geometry">
            <mxRectangle width="1480" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i42__r2__c2" value="Section 14.2, 10.6" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i42__r2" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="102" as="geometry">
            <mxRectangle width="230" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i42__r2__c3" value="SAW, MAW, CRSUB, CRMGR" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i42__r2" vlsit_native_table="1">
