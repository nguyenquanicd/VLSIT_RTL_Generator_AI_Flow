          </mxGeometry>
        </mxCell>
        <mxCell id="i42__r1__c3" value="SAW, SW, SB, SAR, SR, MAW, MW, MB, MAR, MR, CRSUB, CRMGR" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i42__r1" vlsit_native_table="1">
