            <mxRectangle width="330" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i17__r1__c1" value="Structural top of the asynchronous APB bridge. It joins the requester-side block and the completer-side block and holds no logic of its own. One APB transfer crosses the clock boundary as a request bundle and a response bundle; only the request and acknowledge control bits pass through synchronizers." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i17__r1" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="58" as="geometry">
            <mxRectangle width="1480" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i17__r1__c2" value="Section 14.2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i17__r1" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="58" as="geometry">
            <mxRectangle width="230" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i17__r1__c3" value="APM, APS, CRMST, CRSLV" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i17__r1" vlsit_native_table="1">
