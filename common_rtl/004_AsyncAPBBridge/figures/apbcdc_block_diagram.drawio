            <mxRectangle width="330" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i17__r3__c1" value="APB requester of the completer side, in the completer clock domain. It receives the request control bit and the wake-up indication through synchronizers, loads the request bundle into a payload register, drives one APB transfer to the external completer, captures the response into a hold register, and launches the acknowledge control bit. The request and response bundles are stable for the whole handshake, so they cross as timed paths without synchronizers." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i17__r3" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="102" as="geometry">
            <mxRectangle width="1480" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
