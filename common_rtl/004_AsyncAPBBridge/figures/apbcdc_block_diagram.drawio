            <mxRectangle width="360" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i17__r2" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i17__t" vlsit_native_table="1">
          <mxGeometry y="134" width="2400" height="102" as="geometry" />
        </mxCell>
        <mxCell id="i17__r2__c0" value="u_vlsit_apbcdc_mst (m_vlsit_apbcdc_mst)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i17__r2" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="102" as="geometry">
            <mxRectangle width="330" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i17__r2__c1" value="APB completer of the requester side, in the requester clock domain. It captures the Setup phase of a transfer into a hold register, launches the request control bit (a toggle in the two-phase handshake, a level in the four-phase handshake), keeps the response-ready output low until the answer is available, then loads the response bundle and raises the ready output for one cycle. It receives the acknowledge control bit through a synchronizer and passes the optional wake-up indication on to the other side." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i17__r2" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="102" as="geometry">
            <mxRectangle width="1480" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i17__r2__c2" value="Section 14.2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i17__r2" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="102" as="geometry">
            <mxRectangle width="230" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i17__r2__c3" value="REQ, RSP, APM, CRMST" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i17__r2" vlsit_native_table="1">
