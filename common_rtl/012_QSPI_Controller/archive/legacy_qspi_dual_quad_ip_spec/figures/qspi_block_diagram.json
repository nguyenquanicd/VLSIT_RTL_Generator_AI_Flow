 "interfaces": [
  {
   "id": "APB",
   "name": "APB4 software interface",
   "category": "APB4",
   "active": "external -> m_qspi",
   "signals": "external -> m_qspi: i_apb_psel, i_apb_penable, i_apb_paddr, i_apb_pwrite, i_apb_pwdata, i_apb_pstrb, i_apb_pprot; m_qspi -> external: o_apb_pready, o_apb_prdata, o_apb_pslverr"
  },
  {
   "id": "AXI",
   "name": "AXI4 XIP subordinate interface",
   "category": "AXI4",
   "active": "external -> m_qspi for requests; m_qspi -> external for responses",
   "signals": "AW: i_axi_awaddr, i_axi_awid, i_axi_awlen, i_axi_awsize, i_axi_awburst, i_axi_awlock, i_axi_awcache, i_axi_awprot, i_axi_awqos, i_axi_awregion, i_axi_awvalid, o_axi_awready; W: i_axi_wdata, i_axi_wstrb, i_axi_wlast, i_axi_wvalid, o_axi_wready; B: o_axi_bid, o_axi_bresp, o_axi_bvalid, i_axi_bready; AR: i_axi_araddr, i_axi_arid, i_axi_arlen, i_axi_arsize, i_axi_arburst, i_axi_arlock, i_axi_arcache, i_axi_arprot, i_axi_arqos, i_axi_arregion, i_axi_arvalid, o_axi_arready; R: o_axi_rid, o_axi_rdata, o_axi_rresp, o_axi_rlast, o_axi_rvalid, i_axi_rready"
  },
  {
   "id": "SPIN",
   "name": "Serial data and target framing inputs",
   "category": "SPI",
   "active": "external -> m_qspi",
   "signals": "external -> m_qspi: i_spi_cs_n_tgt, i_spi_io_i"
  },
  {
   "id": "SPOT",
   "name": "Serial controller outputs",
   "category": "SPI",
   "active": "m_qspi -> external",
   "signals": "m_qspi -> external: o_spi_sclk_ctrl, o_spi_cs_n_ctrl, o_spi_io_o, o_spi_io_oe"
  },
  {
   "id": "APCLK",
   "name": "APB clock",
   "category": "clock",
   "active": "SoC -> APB domain",
   "signals": "i_clk_apb"
  },
  {
   "id": "AXCLK",
   "name": "AXI clock",
   "category": "clock",
   "active": "SoC -> AXI domain",
   "signals": "i_clk_axi"
  },
  {
   "id": "SECLK",
   "name": "Serial engine reference clock",
   "category": "clock",
   "active": "SoC -> serial engine clock mux",
   "signals": "i_clk_serial"
  },
  {
   "id": "TSCLK",
   "name": "Target-mode external serial clock",
   "category": "clock",
   "active": "external controller -> target engine",
   "signals": "i_spi_sclk_tgt"
  },
  {
   "id": "RST",
   "name": "Asynchronous reset inputs",
   "category": "reset",
   "active": "SoC -> reset synchronizers",
   "signals": "i_rst_n_apb, i_rst_n_axi, i_rst_n_serial"
  },
  {
   "id": "o_irq",
   "name": "Combined QSPI interrupt output",
   "category": "interrupt",
   "active": "m_qspi -> SoC",
   "signals": "o_irq"
  },
  {
   "id": "APBC",
   "name": "APB CSR transaction bundle",
   "category": "APB4",
   "active": "APB decoder -> CSR bank",
   "signals": "APB decoder -> CSR bank: w_csr_psel, w_csr_penable, w_csr_paddr, w_csr_pwrite, w_csr_pwdata, w_csr_pstrb, w_csr_pprot, w_csr_pready, w_csr_prdata, w_csr_pslverr"
  },
  {
   "id": "APBF",
   "name": "APB transmit FIFO push control",
   "category": "stream",
   "active": "APB decoder -> TX FIFO",
   "signals": "w_tx_fifo_push, w_tx_fifo_data, w_tx_fifo_strb, w_tx_fifo_full"
  },
  {
   "id": "APBR",
   "name": "APB receive FIFO pop and data",
   "category": "stream",
   "active": "APB decoder -> RX FIFO for pop; RX FIFO -> APB decoder for data",
   "signals": "w_rx_fifo_pop, w_rx_fifo_data, w_rx_fifo_empty"
  },
  {
   "id": "CFG",
   "name": "CSR control/configuration bundle",
   "category": "control",
   "active": "CSR bank -> indirect controller",
   "signals": "CSR bank -> control: w_ctrl_cfg, w_xip_cfg, w_indirect_cfg; control -> CSR bank: w_status, w_irq_pending"
  },
  {
   "id": "XIPQ",
   "name": "XIP CDC request/response bundle",
   "category": "CDC",
   "active": "AXI XIP adapter -> CDC/arbiter",
   "signals": "w_xip_req_valid, w_xip_req_addr, w_xip_req_id, w_xip_req_len, w_xip_req_ready, w_xip_rsp_valid, w_xip_rsp_ready, w_xip_rsp_data, w_xip_rsp_id, w_xip_rsp_last, w_xip_rsp_resp"
  },
  {
   "id": "INDQ",
   "name": "Indirect-operation request/response bundle",
   "category": "control",
   "active": "Indirect controller -> CDC/arbiter",
   "signals": "w_ind_req_valid, w_ind_req_cmd, w_ind_req_addr, w_ind_req_len, w_ind_req_ready, w_ind_rsp_valid, w_ind_rsp_done, w_ind_rsp_error"
  },
  {
   "id": "ARBR",
   "name": "Controller request arbitration bundle",
   "category": "control",
   "active": "CDC/request queue -> arbiter",
   "signals": "w_ctrl_req_valid, w_ctrl_req_owner, w_ctrl_req_ready"
  },
  {
   "id": "GRNT",
   "name": "Serial engine grant/control bundle",
   "category": "control",
   "active": "arbiter -> serial engine",
   "signals": "w_eng_start, w_eng_owner, w_eng_mode, w_eng_busy, w_eng_done, w_eng_error"
  },
  {
   "id": "TX",
   "name": "Transmit FIFO stream",
   "category": "stream",
   "active": "TX FIFO -> serial engine",
   "signals": "w_tx_data, w_tx_valid, w_tx_ready"
  },
  {
   "id": "RX",
   "name": "Receive FIFO stream",
   "category": "stream",
   "active": "serial engine -> RX FIFO",
   "signals": "w_rx_data, w_rx_valid, w_rx_ready"
  },
  {
   "id": "CLKS",
   "name": "Selected engine clock",
   "category": "clock",
   "active": "clock mux -> serial engine",
   "signals": "w_clk_engine"
  },
  {
   "id": "PINS",
   "name": "Serial engine-to-pad-mux signals",
   "category": "SPI",
   "active": "serial engine -> pin mux for control/data drive; pin mux -> engine for sampled data",
   "signals": "w_sclk_ctrl, w_spi_cs_n_ctrl, w_spi_io_i, w_spi_io_o, w_spi_io_oe"
  },
  {
   "id": "IRQEV",
   "name": "Synchronized interrupt events",
   "category": "interrupt",
   "active": "CDC -> CSR bank",
   "signals": "w_irq_done, w_irq_tx_err, w_irq_rx_err, w_irq_flash_err"
  }
 ],
 "legend_note": "AXI XIP and serial engine use separate clocks. One serial datapath selects i_clk_serial for controller mode or i_spi_sclk_tgt for target mode only while idle."
}
