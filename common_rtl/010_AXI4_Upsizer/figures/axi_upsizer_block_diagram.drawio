          </mxGeometry>
        </mxCell>
        <mxCell id="i29__r3__c1" value="Read path. It accepts the read address, classifies the transaction as packable or not, converts its attributes, keeps the accepted transactions in a queue, and moves the read data of the wide side to the narrow side: a wide beat of a packable burst is split into the narrow beats of its address sequence and the response is copied to each of them; all other read data are taken from the byte lane of their address. A register slice holds every channel." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i29__r3" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
