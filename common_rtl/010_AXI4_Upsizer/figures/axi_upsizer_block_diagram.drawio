          </mxGeometry>
        </mxCell>
        <mxCell id="i29__r1__c1" value="Structural top of the AXI4 upsizer (the AXI3 top has the same blocks). It instantiates the write path and the read path and holds no logic of its own. The subordinate-side interface (narrow data width S) is on the left and the manager-side interface (wide data width M) is on the right." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i29__r1" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="58" as="geometry">
            <mxRectangle width="1480" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i29__r1__c2" value="Section 14.2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i29__r1" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="58" as="geometry">
            <mxRectangle width="230" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i29__r1__c3" value="SAW, SW, SB, SAR, SR, MAW, MW, MB, MAR, MR, CRAXI" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i29__r1" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="58" as="geometry">
            <mxRectangle width="360" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i29__r2" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i29__t" vlsit_native_table="1">
          <mxGeometry y="134" width="2400" height="102" as="geometry" />
        </mxCell>
        <mxCell id="i29__r2__c0" value="u_wr_path (m_vlsit_ups_wr_path)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i29__r2" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="102" as="geometry">
            <mxRectangle width="330" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i29__r2__c1" value="Write path. It accepts the write address, classifies the transaction as packable or not, converts its attributes, keeps the accepted transactions in a queue, and moves the write data of the narrow side to the wide side: write data of a packable burst are merged into wide beats and the strobes are merged with them; all other write data are placed in the byte lane of their address. The write response passes back unchanged. A register slice holds every channel." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i29__r2" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="102" as="geometry">
            <mxRectangle width="1480" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i29__r2__c2" value="Section 14.2, 10.2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i29__r2" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="102" as="geometry">
            <mxRectangle width="230" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i29__r2__c3" value="SAW, SW, SB, MAW, MW, MB, CRAXI" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i29__r2" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="102" as="geometry">
            <mxRectangle width="360" height="102" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i29__r3" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i29__t" vlsit_native_table="1">
          <mxGeometry y="236" width="2400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i29__r3__c0" value="u_rd_path (m_vlsit_ups_rd_path)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i29__r3" vlsit_native_table="1">
