{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerificationContract",
  "description": "Reviewed, RTL-independent interface and behavioral oracle for verification generation.",
  "type": "object",
  "required": ["metadata", "golden_sources", "interface_contract", "requirements", "approval"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["ip_name", "contract_revision", "spec_revision", "config_revision", "status"],
      "properties": {
        "ip_name": {"type": "string"},
        "contract_revision": {"type": "string"},
        "spec_revision": {"type": "string"},
        "config_revision": {"type": "string"},
        "status": {"type": "string", "enum": ["draft", "approved", "stale"]},
        "created_at": {"type": ["string", "null"]}
      }
    },
    "golden_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "document", "revision", "sha256"],
        "properties": {
          "kind": {"type": "string", "enum": ["design_spec", "protocol_standard", "approved_config", "user_decision"]},
          "document": {"type": "string"},
          "revision": {"type": "string"},
          "clauses": {"type": "array", "items": {"type": "string"}},
          "errata": {"type": "array", "items": {"type": "string"}},
          "profile": {"type": ["string", "null"]},
          "sha256": {"type": ["string", "null"]}
        }
      }
    },
    "interface_contract": {
      "type": "object",
      "required": ["interface_name", "clocks_resets", "signals", "parameters"],
      "properties": {
        "interface_name": {"type": "string"},
        "description": {"type": "string"},
        "clocks_resets": {"type": "array", "items": {"$ref": "#/definitions/clockReset"}},
        "signals": {"type": "array", "items": {"$ref": "#/definitions/signal"}},
        "parameters": {"type": "array", "items": {"$ref": "#/definitions/parameter"}}
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["req_id", "sources", "preconditions", "stimulus", "observable_behavior", "timing", "test_ids", "property_ids", "coverage_points", "status"],
        "properties": {
          "req_id": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "stimulus": {"type": "array", "items": {"type": "string"}},
          "observable_behavior": {"type": "string"},
          "timing": {"type": ["string", "null"]},
          "error_recovery": {"type": "array", "items": {"type": "string"}},
          "test_ids": {"type": "array", "items": {"type": "string"}},
          "property_ids": {"type": "array", "items": {"type": "string"}},
          "coverage_points": {"type": "array", "items": {"type": "string"}},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["reviewed", "needs_clarification", "not_applicable"]},
          "disposition": {"type": ["string", "null"]}
        }
      }
    },
    "approval": {
      "type": "object",
      "required": ["status", "approved_at"],
      "properties": {
        "status": {"type": "string", "enum": ["pending", "approved", "rejected"]},
        "approved_at": {"type": ["string", "null"]},
        "decision_note": {"type": ["string", "null"]}
      }
    }
  },
  "definitions": {
    "clockReset": {
      "type": "object",
      "required": ["name", "role", "polarity", "sources"],
      "properties": {
        "name": {"type": "string"},
        "role": {"type": "string", "enum": ["clock", "reset"]},
        "polarity": {"type": ["string", "null"]},
        "sources": {"type": "array", "items": {"type": "string"}}
      }
    },
    "signal": {
      "type": "object",
      "required": ["name", "direction", "width", "sources"],
      "properties": {
        "name": {"type": "string"},
        "direction": {"type": "string", "enum": ["input", "output", "inout"]},
        "width": {"type": "string", "description": "Specification-defined width expression, e.g. 1 or DATA_WIDTH."},
        "protocol_role": {"type": ["string", "null"]},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "parameter": {
      "type": "object",
      "required": ["name", "value", "sources"],
      "properties": {
        "name": {"type": "string"},
        "value": {"type": "string"},
        "sources": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
