# The content below for example with gitignore file, based on your EDA tool, you can adjust the content below accordingly.
#------------------------------------------------------------------------------------------------------------------------

# ── Working directories (root only) ─────────────────────────────────────────
# Result/*/ sim/ and work/
/sim/
/work/

# ── Yosys intermediate ───────────────────────────────────────────────────────
# CHỈ *.blif — KHÔNG ignore *.json vì schemas/*.json là gate artifact
*.blif

# ── Generated RTL/TB/SVA ở root (root only) ──────────────────────────────────
# Result/*/ src/ KHÔNG bị ignore
/src/rtl/
/src/sva/
/src/tb/

# ── Generated docs ở root ────────────────────────────────────────────────────
/docs/specification.pdf

# ── OS & Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── Files generated by running simulations ───────────────────────────────────
# Keep only the testbench, test cases, environment files, run scripts (Makefile, runner), and READMEs.
# Logs, other waveform dumps, compiled simulation images, run output folders and run summaries are not versioned.
# EXCEPTION: the simulated waveforms kept for comparison with the specification (*.vcd and the evidence folder
# verification/waveforms_sim/ with its WaveJSON, SVG and waveform_compare.md, rule R-033) stay versioned.
*.log
*.fst
*.fsdb
*.vpd
*.wlf
*.shm/
*.vvp
*.vdb/
*.ucdb
obj_dir/
simv
simv.daidir/
csrc/
urgReport/
DVEfiles/
ucli.key
**/verification/logs/
**/verification/sim_logs/
**/verification/build/
**/verification/build_waves/
**/waveforms/proto/build/
**/verification/*_run.txt
**/verification/mutation_result.txt

# Non-redistributable protocol and device references (converted Markdown only)
/common_rtl/009_HyperRAM_Controller/reference/md_doc/hyperbus_001-99253_rev_h.md
/common_rtl/009_HyperRAM_Controller/reference/md_doc/infineon_s80ks2562_002-31337_rev_c.md
/common_rtl/009_HyperRAM_Controller/reference/md_doc/infineon_s80ks2564_002-31341_rev_c.md
/common_rtl/009_HyperRAM_Controller/reference/md_doc/winbond_w958d8nbya_256mb_x8_a01-003.md
/common_rtl/009_HyperRAM_Controller/reference/md_doc/winbond_w958d6nbkx_256mb_x16_a01-001.md
/common_rtl/009_HyperRAM_Controller/reference/md_doc/issi_is66wvh32m8dall_bll_rev_a7.md

/common_rtl/009_HyperRAM_Controller/reference/md_doc/amba_apb_ihi0024d_apb4_profile.md
/common_rtl/009_HyperRAM_Controller/reference/md_doc/vlsit_amba_axi_ihi0022hc.md
