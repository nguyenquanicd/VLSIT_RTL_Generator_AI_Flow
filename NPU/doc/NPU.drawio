        <mxCell id="dvz7KDq_2vct3IUIVs_H-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Computing Core" vertex="1">
          <mxGeometry height="120" width="160" x="255" y="100" as="geometry" />
        </mxCell>
        <mxCell id="dvz7KDq_2vct3IUIVs_H-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Computing Core" vertex="1">
          <mxGeometry height="120" width="160" x="275" y="120" as="geometry" />
        </mxCell>
        <mxCell id="dvz7KDq_2vct3IUIVs_H-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Multi Core: support inference multi model&lt;/div&gt;&lt;div&gt;Eg: automotive - processing both images and radar/LiDAR data&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;Command Queue &amp;amp; Decoding:&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;ul&gt;&lt;li&gt;Provide&amp;nbsp;high-speed communication channels with the host&lt;/li&gt;&lt;li&gt;Buffers instructions from the host, reports events (task complete,...) to the host&lt;/li&gt;&lt;li&gt;Instruction decoding break large tasks into hardware-executable subtasks,&amp;nbsp;identify operations that can be executed in parallel&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Computing Core:&lt;br&gt;&lt;ul&gt;&lt;li&gt;PE Array: Large-scale parallel processing unit that performs MAC operations&lt;/li&gt;&lt;li&gt;Vector Unit: Handles activation functions, and other vector operations and supports specific operations such as lookup tables&lt;/li&gt;&lt;li&gt;Local controller: manages the execution flow and data flow of PE arrays&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;On-chip Buffer: L1 SRAM&lt;br&gt;&lt;ul&gt;&lt;li&gt;Storage weights and results&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;DMA: data tranmision&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="720" x="75" y="420" as="geometry" />
        </mxCell>
        <mxCell id="dvz7KDq_2vct3IUIVs_H-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1" value="On-chip Buffer" vertex="1">
