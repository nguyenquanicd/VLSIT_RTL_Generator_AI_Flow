        <mxCell id="dvz7KDq_2vct3IUIVs_H-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Computing Core" vertex="1">
