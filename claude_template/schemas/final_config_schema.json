{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FinalConfig",
  "description": "Phase 2 output from config_ui; approved configuration for subsequent RTL and verification-contract work.",
  "type": "object",
  "required": [
    "metadata",
    "parameters",
    "constraints",
    "style_constraints",
    "feature_matrix"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "ip_name",
        "spec_revision",
        "phase",
        "gate_status",
        "gate_2_approved"
      ],
      "properties": {
        "ip_name": {
          "type": "string",
          "example": "rv32im_core"
        },
        "spec_revision": {
          "type": "string",
          "example": "0.2"
        },
        "phase": {
          "type": "integer",
          "const": 2
        },
        "gate_status": {
          "type": "string",
          "enum": [
            "pending",
            "approved"
          ]
        },
        "gate_2_approved": {
          "type": "boolean"
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO 8601 timestamp of the user's Gate 2 approval."
        }
      }
    },
    "parameters": {
      "type": "object",
      "description": "Map from parameter names to selected values and metadata; each key is a parameter name.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "value",
          "default",
          "type",
          "changed_from_default",
          "confirmed_by_user"
        ],
        "properties": {
          "value": {
            "type": "string",
            "description": "Value selected by the user."
          },
          "default": {
            "type": "string",
            "description": "Default value from the specification."
          },
          "type": {
            "type": "string",
            "description": "SystemVerilog data type."
          },
          "changed_from_default": {
            "type": "boolean"
          },
          "confirmed_by_user": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean",
            "description": "True when the parameter is locked and cannot be overridden."
          },
          "req_ids_affected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "feature_ids_affected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "change_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reason for changing the specification default, if applicable."
          }
        }
      },
      "examples": [
        {
          "PR_BOOT_ADDR": {
            "value": "32'h8000_0000",
            "default": "32'h8000_0000",
            "type": "logic [31:0]",
            "changed_from_default": false,
            "confirmed_by_user": true,
            "locked": false,
            "req_ids_affected": [],
            "feature_ids_affected": [
              "F01",
              "F05"
            ],
            "change_reason": null
          }
        }
      ]
    },
    "constraints": {
      "type": "object",
      "description": "Results of applicable elaboration-constraint checks from the specification.",
      "properties": {
        "C1": {
          "type": "object",
          "properties": {
            "rule": {
              "type": "string",
              "const": "PR_BOOT_ADDR[1:0] == 2'b00"
            },
            "pass": {
              "type": "boolean"
            },
            "detail": {
              "type": "string"
            }
          }
        },
        "C2": {
          "type": "object",
          "properties": {
            "rule": {
              "type": "string",
              "const": "PR_MTVEC_RESET[1:0] == 2'b00"
            },
            "pass": {
              "type": "boolean"
            },
            "detail": {
              "type": "string"
            }
          }
        },
        "C3": {
          "type": "object",
          "properties": {
            "rule": {
              "type": "string",
              "const": "PR_IRQ_EN == 1 → PR_CSR_EN == 1"
            },
            "pass": {
              "type": "boolean"
            },
            "detail": {
              "type": "string"
            }
          }
        },
        "C4": {
          "type": "object",
          "properties": {
            "rule": {
              "type": "string",
              "const": "PR_MTVEC_VEC_EN == 1 → PR_CSR_EN == 1"
            },
            "pass": {
              "type": "boolean"
            },
            "detail": {
              "type": "string"
            }
          }
        },
        "C5": {
          "type": "object",
          "properties": {
            "rule": {
              "type": "string",
              "const": "PR_COUNTER_EN == 1 → PR_CSR_EN == 1"
            },
            "pass": {
              "type": "boolean"
            },
            "detail": {
              "type": "string"
            }
          }
        }
      }
    },
    "style_constraints": {
      "type": "object",
      "required": [
        "source_file",
        "lint_rules"
      ],
      "properties": {
        "source_file": {
          "type": [
            "string",
            "null"
          ],
          "description": "Path to the selected RTL rule file. New outputs require a path; null is only for reading legacy configurations before migration."
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "repository_default",
            "user_supplied"
          ],
          "description": "Origin of the selected RTL rule file."
        },
        "natural_language_additions": {
          "type": "array",
          "description": "Additional style constraints supplied by the user in natural language.",
          "items": {
            "type": "string"
          }
        },
        "lint_rules": {
          "type": "array",
          "description": "Normalized lint rules derived from natural-language constraints.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "source",
              "rule"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Rule identifier, for example STYLE-001."
              },
              "source": {
                "type": "string",
                "enum": [
                  "default_rule_file",
                  "user_rule_file",
                  "rtl_rule.md",
                  "user_addition"
                ]
              },
              "rule": {
                "type": "string",
                "description": "Concise description of the rule."
              },
              "original_nl": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Original user wording when the rule is a user addition."
              }
            }
          }
        }
      }
    },
    "feature_matrix": {
      "type": "object",
      "description": "Enabled or disabled status for each specification feature.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled",
          "mandatory"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "mandatory": {
            "type": "boolean",
            "description": "True when the specification requires the feature in every build."
          },
          "parameters_driving": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Parameters that control whether this feature is enabled."
          },
          "req_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "examples": [
        {
          "F02": {
            "enabled": true,
            "mandatory": true,
            "parameters_driving": [
              "PR_M_EXT_EN"
            ],
            "req_ids": [
              "REQ-002"
            ]
          },
          "F16": {
            "enabled": true,
            "mandatory": false,
            "parameters_driving": [
              "PR_COUNTER_EN"
            ],
            "req_ids": [
              "REQ-016"
            ]
          }
        }
      ]
    }
  }
}
